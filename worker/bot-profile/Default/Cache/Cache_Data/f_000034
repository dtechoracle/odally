  color: #fff;
}

.onboardingNotification .notificationBody {
  background-color: #fff;
  display: flex;
  flex-direction: column;
}

.onboardingNotification .notificationBody ul {
  position: relative;
  list-style: none;
  max-width: 315px;
  background: #fff;
  margin: auto;
  box-shadow: 0px 0px 3px #0000001a;
  border: 1px solid #ececec;
  border-radius: 8px;
  width: 100%;
  padding: 0;
}

.onboardingNotification .notificationBody ul li {
  font-size: 14px;
  padding: 20px 25px;
  font-family: "Poppins";
  border-bottom: 1px solid #ececec;
  color: #46445d;
}

.onboardingNotification .notificationBody ul li.completedPoint {
  color: #8f8ea0;
}

/* .onboardingNotification .notificationBody ul li.nextPoint{
  color: #46445D;
  font-weight: 500;
} */
.onboardingNotification .notificationBody ul li:first-child {
  border-top-left-radius: 8px;
  border-top-right-radius: 8px;
}

.onboardingNotification .notificationBody ul li:last-child {
  border-bottom: 0px;
}

.floatleft {
  margin: auto;
  width: calc(100% - 70px);
  padding-left: 10px;
}

.onboardingNotification .notificationBody button {
  font-family: "Poppins";
