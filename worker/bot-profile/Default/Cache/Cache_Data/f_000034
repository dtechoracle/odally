.onboardingNotification {
  position: fixed;
  bottom: 100px;
  right: 25px;
  z-index: 9999;
  box-shadow: 0px 4px 12px #0000001a;
  border-radius: 12px;
  max-width: 350px;
  width: 100%;
}

.onboardingNotification .notificationHead {
  background-color: #1a1a1a;
  border-radius: 12px;
  padding: 10px 15px 10px;
  display: flex;
  width: 100%;
  justify-content: center;
  cursor: pointer;
}

.onboardingNotification.active .notificationHead {
  padding: 15px 20px 40px;
  border-radius: 12px 12px 0px 0px;
}

.onboardingNotification.active .notificationBody ul {
  top: -30px;
}

