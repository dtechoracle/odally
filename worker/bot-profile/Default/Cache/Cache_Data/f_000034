}

.onboardingNotification .notificationBody button:hover {
  background-color: #f2f2f2;
}

.single-chart {
  width: 70px;
  margin: auto;
  justify-content: space-around;
}

.circular-chart {
  display: block;
  margin: 10px auto;
  max-width: 80%;
  max-height: 250px;
}

.circle-bg {
  fill: none;
  stroke: #bcc0c7;
  stroke-width: 3;
}

.circle {
  fill: none;
  stroke-width: 3;
  stroke-linecap: round;
  animation: progress 1s ease-out forwards;
}

