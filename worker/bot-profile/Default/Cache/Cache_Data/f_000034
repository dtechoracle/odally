:root {
  --main-bg-image: linear-gradient(to right, #08b3e5, #63d6b5);
}

* {
  outline: none;
  box-sizing: border-box;
}

::-webkit-scrollbar {
  width: 6px;
  height: 4px;
}

/* Track */
::-webkit-scrollbar-track {
  background: #f1f1f1;
  border-radius: 6px;
}

/* Handle */
::-webkit-scrollbar-thumb {
  background: rgba(0, 0, 0, 0.5);
  border-radius: 6px;
}

/* Handle on hover */
::-webkit-scrollbar-thumb:hover {
  background: #888;
}

html {
  height: 100%;
}

body {
  width: 100%;
  overflow-x: hidden;
  background-color: #fff;
  color: #54536c;
  font-family: "PT Sans";
  height: 100%;
}

.grecaptcha-badge {
  visibility: collapse !important;
}

#hideViewallSection {
  border: none;
  float: right;
  font-size: 18px;
