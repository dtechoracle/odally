function plansajaxcalls(url,data){
      
      return new Promise(function(resolve, reject) {
      
          let xhttp;
          xhttp = new XMLHttpRequest();
          xhttp.open("POST", url, true);
          xhttp.setRequestHeader( "Access-Control-Allow-Origin", '*' );
          xhttp.setRequestHeader( "Access-Control-Allow-Credentials", "true" );
          xhttp.setRequestHeader('Content-type', 'application/x-www-form-urlencoded');
          xhttp.setRequestHeader("X-CSRFToken", csrftoken );
          
          xhttp.onreadystatechange = function() {
                  if (this.readyState == 4 ){
                        if(this.status == 200) {
                              resolve(xhttp.responseText);
                        }
                        else if (xhttp.status == 511){
                              resultjson = JSON.parse(xhttp.responseText)
                              console.log(resultjson)
                              if (resultjson.message ==  "Oauth Authentication Required"){
                                    window.location.href = redirecturlserver + "/logout"; 
                              }
                        }
                        else{
                              let usererrMsg 
                              if(this.status == 0 ){
                                    usererrMsg = "{% trans 'Please check your internet connection and retry.' context 'NetworkError-NoticationMessage' %}"
                              }
                              else if(this.status == 500){
                                    usererrMsg = "{% trans 'Internal server error. Please try again later.' context 'NetworkError-NoticationMessage' %}"
                              }
                              else if(this.status == 400 || this.status == 408){
                                    usererrMsg = "{% trans 'Something went wrong. Please try again' context 'NetworkError-NoticationMessage' %}"
                              }
                              else if(this.status == 403){
                                    usererrMsg = "{% trans 'Something went wrong. Try logging in again.' context 'NetworkError-NoticationMessage' %}"
                              }
                              else {
                                    usererrMsg = "{% trans 'Something went wrong. Please try again' context 'NetworkError-NoticationMessage' %}" 
                              }
                  
                              $("#NotificationbarMessage").html(usererrMsg)
                              $(".Notification_popupbar").fadeIn();
                              successfade(); 
                  
                              reject("reject")
                        }
                  }
          };
          xhttp.send(data);
      })
}

