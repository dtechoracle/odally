$(".enterpriseDataSubmit").on('click', function(){
      
      let getElement = document.getElementById.bind(document);
      let getElementClass = document.getElementsByClassName.bind(document)

      let epName = getElement("enterpriceUsername")
      let epCname = getElement("enterpricecompanyname")
      let epMail = getElement("enterpriceCompanyEmail")
      let epMobno = getElement("enterpricePhoneNo")
      let epLicense = getElement("enterpriceLicense")
      
      let epnameValidate  = epnameValidatefn(epName);
      let epcompanyValidate  = epcompanyValidatefn(epCname);
      let epmailValidate = epmailValidatefn(epMail);
      let epmobnoValidate = epmobnoValidatefn(epMobno);
      
      let submit_path = 'Myplans';

      let anim_overlay = getElementClass("lds-animaker-overlay")[0]
      let enterprise_dropdown = getElement("enterpriselicence_dropdown_block")
      let enterprise_error = getElementClass("enterpriseform_error")
      
      $.getJSON('https://ipapi.co/json/', function(data) {
            if(epnameValidate || epcompanyValidate || epmailValidate || epmobnoValidate){
                  return false;
            }
            else{
                  anim_overlay.style.display = "block";
                  
                  let respData = `a=${btoa(epName.value)}&b=${btoa(epMail.value)}&c=${btoa(epMobno.value)}&d=${btoa(epLicense.value)}&f=${btoa(data.country)}&e=${btoa(submit_path)}&g=${btoa(data.region)}&h=${btoa(epCname.value)}&i=${btoa(data.city)}`
                  
                  plansajaxcalls(siteurl+'/p/pes/', respData).then(function(result){
                        result = JSON.parse(result);
                  
                        anim_overlay.style.display = "none";
                        $('.anim-new-modal-overlay, .anim-new-modal.enterprise_modal ').fadeOut();
                        getElement("NotificationbarMessage").innerHTML = result['msg'];
                        $('.Notification_popupbar').fadeIn();
                        successfade()
                  
                        epName.value= ""
                        epMail.value =""
                        epMobno.value =""
                        enterprise_dropdown.style.display = "none"
                        Array.from(enterprise_error).map((key,val)=>{ key.innerHTML=""; })
                  }, function(error) {
                        anim_overlay.style.display = "none";
                        $('.anim-new-modal-overlay, .anim-new-modal.enterprise_modal').fadeOut();
                  
                        epName.value= ""
                        epMail.value =""
                        epMobno.value =""
                        enterprise_dropdown.style.display = "none"
                        Array.from(enterprise_error).map((key,val)=>{ key.innerHTML=""; })
                  })
            }
      });
      
      // function to validate username
      function epnameValidatefn(arg){
            const trim_arg = arg.value.trim()
            if(trim_arg == ""){
                  arg.style.border = "1px solid #ff0000"
                  enterprise_error[0].innerHTML = "{% trans 'Please enter your name.' context 'Username-Validation' %}"
                  return true;
            }
            else if(trim_arg.length < 2){
                  arg.style.border = "1px solid #ff0000"
                  enterprise_error[0].innerHTML = "{% trans 'Name must contain 2 characters.' context 'Username-Validation' %}"
                  return true;
            }
            return false;
      }
      
      // function to validate company name
      function epcompanyValidatefn(arg){
            const trim_arg = arg.value.trim()
            if(trim_arg == ""){
                  arg.style.border = "1px solid #ff0000"
                  enterprise_error[1].innerHTML = "{% trans 'Please enter your company name.' context 'Companyname-Validation' %}"
                  return true;
            }
            return false;
      }
      
      // function to validate email
      function epmailValidatefn(arg){
            let regemail =  /^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{1,100})+$/;
            const trim_arg = arg.value.trim()
            if(trim_arg == ""){
                  arg.style.border = "1px solid #ff0000"
                  enterprise_error[2].innerHTML = "{% trans 'Please enter your email address.' context 'Email-Validation' %}"
                  return true;
            }
            else if(regemail.test(arg.value) == false){
                  arg.style.border = "1px solid #ff0000"
                  enterprise_error[2].innerHTML = "{% trans 'Please enter a valid email address.' context 'Email-Validation' %}"
                  return true;
            }
            return false;
      }
      
      // function to validate mobile no
      function epmobnoValidatefn(arg){
            const trim_arg = arg.value.trim()
            if(trim_arg.length > 0  && trim_arg.length < 8 ){
                  arg.style.border = "1px solid #ff0000"
                  enterprise_error[3].innerHTML = "{% trans 'Phone number should be atleast 8 digits.' context 'Mobileno-Validation' %}"
                  return true;
            }
            return false;
      }
      
});

