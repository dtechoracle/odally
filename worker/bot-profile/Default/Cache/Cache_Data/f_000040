function getAppliedCoupon() {

   let couponCode = getCookie('cc');
   let couponPlan = getCookie('p');

   if (couponCode == null || couponCode == '') {
        return;
   }

   let couponPlanName = couponPlan.split('_')[0];
   let couponCycle = couponPlan.split('_')[1];
   document.getElementsByClassName("lds-animaker-overlay")[0].style.display = "block";

   if (couponPlanName == 'all') {
    if (current_plan == 'lite') {
        couponPlanName = 'starter'
    } else{
        couponPlanName = current_plan;
    }
   }
   pr_planname = couponPlanName;

   let isValid = ApplyAndValidateCoupon(couponCode, couponPlanName, couponCycle).then(res => {
        // This code is executed when the Promise is resolved.
        console.log(res); // "The value"
        clickPlan(pr_planname);
        return res;
   }).catch(error => {
        // This code is executed when the Promise is rejected.
        console.log(error); // "An error occurred"
        document.getElementsByClassName("lds-animaker-overlay")[0].style.display = "none";
        return false;
   });
}

function getProrationAmount(upgradeToPlan, downgradeFlag) {
    if (typeof (upgradeToPlan) == 'undefined') {
        return
    }
    if (current_plan == upgradeToPlan && plantype == 'yearly'  && (paymentModes.includes('bt') || (paymentModes.includes('paypal') && downgradeFlag != true ))) {
        document.getElementsByClassName("anim-new-modal-overlay")[0].style.display = "none";              //black screen for popup
        $("#NotificationbarMessage").html('You are already in same plan');
        $('.Notification_popupbar').fadeIn();
        successfade();
        $(".lds-animaker-overlay").fadeOut();
        return;
    }


    if (typeof (teamId) == 'undefined') {
        teamId = teamid;
    }
    var url = redirecturlserver + '/payments/p/gpa/';
    var proration = true;
    if (downgradeFlag) {
        proration = false;
    }

    if (current_plan == 'lite' || pastDue > 0) {
        proration = false;
    }

    data = 'a=' + btoa(teamId) + '&b=' + btoa('upgrade') + '&c=' + btoa(proration) + '&d=' + btoa(upgradeToPlan);
    // document.getElementsByClassName("anim-new-modal-overlay")[0].style.display = "none";
    $(".lds-animaker-overlay").fadeIn();
    fbajaxcall(url, data, null).then(function (result) {
        result = JSON.parse(result);
        if (!result['error']) {
            teamSize = atob(result['c']);
            proration = atob(result['d']);
            monthCost = atob(result['e']);
            monthCost = parseFloat(monthCost).toFixed(2)
            yearCost = atob(result['f']);
            yearCost = parseFloat(yearCost).toFixed(2)
            r_maskedcc = atob(result["a"]);
            r_brand = atob(result["b"]);
            b_d = atob(result["bd"]);
            nonce = atob(result["n"]);
            refund = atob(result['r'])
            refund = parseFloat(refund).toFixed(2)
            if (monthCost == '0.00' && yearCost == '0.00') {
                document.getElementsByClassName("anim-new-modal-overlay")[0].style.display = "none";              //black screen for popup
                $("#NotificationbarMessage").html('Upgrade not allowed');
                $('.Notification_popupbar').fadeIn();
                successfade();
                $(".lds-animaker-overlay").fadeOut();
                return;
            }
            teamDetails = { 'teamSize': teamSize, 'proration': proration, 'plan': upgradeToPlan, 'monthCost': atob(result['e']), 'yearCost': yearCost, 'teamId': teamId, 'downgradeFlag': downgradeFlag , "refund" : refund };
            showPaymentModal(teamSize, monthCost, yearCost, downgradeFlag,refund);
            } 
        else {
            if(result["errormsg"]) {
                document.getElementsByClassName("anim-new-modal-overlay")[0].style.display = "none";              //black screen for popup
                $("#NotificationbarMessage").html(result["errormsg"])
                $('.Notification_popupbar').fadeIn();
                successfade();
            }
        }
        $("#displaycarderrors").html("");
        $(".lds-animaker-overlay").fadeOut();
    });
}

