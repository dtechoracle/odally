function getCurrencyExchange() {
    $(".local-currency-amount").text('');
    $(".currency").hide();
    amount = $("#totalCostAmountPay").html().replace('$', '').replace(',','').trim();
    if (amount.trim() == '') {
        amount = $("#license_total_cost").html().replace('$', '').replace(',','').trim();
    }
    if (!cc || cc == '') {
        cc = countryCode;
    }
    $(".select-country").val(cc);
    params = "a=" + amount + "&c=" + cc;
    $.ajax({
        url: siteurl + "/cc/convert?" + params,
        mode: 'cors',
        withCredentials: false,
        headers: { 'Access-Control-Allow-Origin': '*', "X-CSRFToken": csrftoken },
        xsrfHeaderName: "X-CSRFToken",
        type: 'get',
        success: function (result) {
            if (result['success']) {
                $(".currency").show();
                converted = result['amount'];
                $(".local-currency-amount").text(converted);
            } else {
                $(".currency").hide();
            }
        }
    });
}
