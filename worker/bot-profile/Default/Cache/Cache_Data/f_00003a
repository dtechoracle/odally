.checkboxStyle{border-radius:50px;border:1px solid #f29b4b;width:16px;height:16px;margin-right:8px;font-size:12px;color:#fff;text-align:center;line-height:14px;font-weight:200;display:inline-block;top:0px;float:left;position: relative;}
