{
   "action": {
      "default_icon": {
         "19": "images/icons/tray_19.png",
         "38": "images/icons/tray_38.png"
      }
   },
   "background": {
      "service_worker": "backgroundServiceWorker.js"
   },
   "commands": {
      "KEY_CANCEL_RECORDING": {
         "description": "To cancel recording",
         "suggested_key": {
            "default": "Shift+Ctrl+X",
            "mac": "Shift+Command+X",
            "windows": "Shift+Ctrl+X"
         }
      },
      "KEY_MUTE_UNMUTE_RECORDING": {
         "description": "To mute or unmute recording",
         "suggested_key": {
            "default": "Shift+Ctrl+U",
            "mac": "Shift+Command+U",
            "windows": "Shift+Ctrl+U"
         }
      },
      "KEY_PAUSE_RESUME_RECORDING": {
         "description": "To pause or resume recording",
         "suggested_key": {
            "default": "Shift+Ctrl+1",
            "mac": "Shift+Command+1",
            "windows": "Shift+Ctrl+1"
         }
      },
      "KEY_STOP_RECORDING": {
         "description": "To stop recording",
         "suggested_key": {
            "default": "Shift+Ctrl+2",
            "mac": "Shift+Command+2",
            "windows": "Shift+Ctrl+2"
         }
      }
   },
   "content_scripts": [ {
      "css": [ "/css/root.css" ],
      "js": [ "/static/js/content.js" ],
      "matches": [ "\u003Call_urls>" ]
   }, {
      "js": [ "inboxsdk-v3.js" ],
      "matches": [ "https://mail.google.com/*" ],
      "run_at": "document_start"
   }, {
      "js": [ "/static/js/gmail-content.js" ],
      "matches": [ "https://mail.google.com/*" ],
      "run_at": "document_idle"
   }, {
      "js": [ "/static/js/getWindow.js" ],
      "matches": [ "\u003Call_urls>" ]
   }, {
      "js": [ "/static/js/jira-content.js" ],
      "matches": [ "https://*.jira-dev.com/*", "https://*.atlassian.net/*", "https://*.atlassian.com/*", "https://*.jira.com/*" ]
   }, {
      "js": [ "/static/js/google-meet-content.js" ],
      "matches": [ "https://meet.google.com/**-**-**" ]
   }, {
      "js": [ "/static/js/github-content.js" ],
      "matches": [ "https://github.com/*/pull/*", "https://github.com/*/compare/*", "https://github.com/*/issues/*", "https://github.com/*/wiki/*", "https://*.github.com/*" ]
   }, {
      "js": [ "/static/js/gitlab-content.js" ],
      "matches": [ "https://gitlab.com/*/*/-/merge_requests/*", "https://gitlab.com/*/*/-/merge_requests/*/diffs", "https://*.gitlab.com/*" ]
   }, {
      "js": [ "/static/js/intercom-content.js" ],
      "matches": [ "https://app.intercom.com/*" ]
   }, {
      "css": [ "/static/css/hubspot-content.css" ],
      "js": [ "/static/js/hubspot-content.js" ],
      "matches": [ "https://*.hubspot.com/contacts/*" ]
   } ],
   "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
   },
   "description": "Record tutorials, demos, and educational videos, let AI transfrom them into bite-sized clips and viral-ready shorts.",
   "externally_connectable": {
      "matches": [ "\u003Call_urls>" ]
   },
   "homepage_url": "https://app.vmaker.com/dashboard/",
   "host_permissions": [ "\u003Call_urls>" ],
   "icons": {
      "128": "images/icons/tray_128.png",
      "16": "images/icons/tray_16.png",
      "48": "images/icons/tray_48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Free Screen Recorder by Vmaker AI",
   "permissions": [ "tabCapture", "activeTab", "tabs", "scripting", "storage", "desktopCapture", "notifications", "unlimitedStorage", "idle" ],
   "short_name": "Free Screen Recorder by Vmaker AI",
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "6.1.0",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "vmaker-content.html", "pinnedTab.html", "/static/css/content.css", "/static/media/*", "/static/js/*.js", "inboxsdk-v3.js", "/app/virtual_bg_assets/*" ]
   } ]
}
